go":"/adventure/jurassic-rescue/title-logo.webp","hero":"/adventure/jurassic-rescue/hero.jpg","heroAlt":"Dr Everstone beside a Triceratops in a vast prehistoric landscape of waterfalls, forests and dinosaurs","collectionSubject":"Brachiosaurus","collectionHeadline":["Collect. Play.","Level up."],"collectionIntroduction":"Find stickers as you explore. Learn the stories behind them, then play minigames and upgrade your collection to complete the game.","accessHeadline":["Ready to step","into prehistory?"],"theme":{"id":"prehistoric","accent":"#eed89b","brass":"#eed89b","ink":"#132f28","heroPosition":"62% 36%","heroMobilePosition":"50% top","logoTop":"17%","motif":"fossil","colors":["#7c6925","#346239","#173d35"],"backdrop":"/adventure/jurassic-rescue/planet-backdrop.jpg","pattern":"/adventure/jurassic-rescue/pattern.svg"},"discoveryCount":32,"collectibleCount":127,"story":{"headline":["Dr. Everstone","has disappeared."],"description":"A mysterious vortex has pulled Dr. Everstone millions of years into the past. Follow her trail through prehistoric worlds, uncover the evidence and use what you learn to bring her home.","artwork":"/adventure/jurassic-rescue/world-v2.webp","artworkCaption":"Millions of years. One rescue mission.","learningLine":"Discover dinosaurs, fossil evidence and the changing story of life on Earth.","rewardBoxCount":2},"chapters":[{"id":"chapter-01","title":"The Dig Site","image":"/resources/jurassic-rescue/hero-chapter-01.webp"},{"id":"chapter-02","title":"Dawn of Dinosaurs","image":"/resources/jurassic-rescue/hero-chapter-02.webp"},{"id":"chapter-03","title":"Giants of the Jurassic","image":"/resources/jurassic-rescue/hero-chapter-03.webp"},{"id":"chapter-04","title":"The Cretaceous Wetlands","image":"/resources/jurassic-rescue/hero-chapter-04.webp"},{"id":"chapter-05","title":"The Last Roar","image":"/resources/jurassic-rescue/hero-chapter-05.webp"},{"id":"chapter-06","title":"The Asteroid Caves","image":"/resources/jurassic-rescue/hero-chapter-06.webp"}],"learningStages":[{"id":"journey","label":"Journey","headline":["One rescue mission.","Six chapters through time."],"description":"Follow Dr. Everstone’s trail through six connected chapters, with prehistoric discoveries and new challenges along the way.","image":"/adventure/jurassic-rescue/journey.jpg","alt":"The actual Jurassic Rescue map showing the story, chapters and connected quizzes"},{"id":"explore","label":"Explore","headline":["Look for clues.","Meet prehistoric giants."],"description":"Explore richly illustrated prehistoric scenes. Tap discoveries to watch short videos and learn what fossils, animals and plants reveal about the past.","image":"/adventure/jurassic-rescue/explore.jpg","alt":"Actual Jurassic Rescue gameplay in a prehistoric forest with dinosaurs and discoveries"},{"id":"play","label":"Play","headline":["Think like","a palaeontologist."],"description":"Put your discoveries to work in quizzes, puzzles and minigames that build observation, memory and scientific reasoning.","image":"/adventure/jurassic-rescue/play.jpg","alt":"A genuine dinosaur learning challenge from Jurassic Rescue"},{"id":"collect","label":"Collect","headline":["Build your own","prehistoric collection."],"description":"Collect what you discover, earn Gold editions through play and unlock Epic artwork with gems. Grow your collection as the rescue unfolds.","image":"/adventure/jurassic-rescue/collect.jpg","alt":"The actual Jurassic Rescue stickerbook showing fossil discoveries in mixed editions"}],"editions":[{"id":"discovery","label":"Discovery","image":"/adventure/jurassic-rescue/brachiosaurus-discovery.jpg","explanation":"Find a discovery, learn its story and earn its sticker."},{"id":"gold","label":"Gold","image":"/adventure/jurassic-rescue/brachiosaurus-gold.jpg","explanation":"Beat the sticker’s minigame to earn its Gold edition."},{"id":"epic","label":"Epic","image":"/adventure/jurassic-rescue/brachiosaurus-epic.jpg","explanation":"Use your gems to unlock its Epic artwork."}],"learningAreas":[{"label":"Scientific enquiry","title":"Read the clues in the rocks.","description":"Discover how palaeontologists use bones, footprints and scientific tools to reconstruct the past. Practise observing, comparing and drawing conclusions from evidence.","example":"From a footprint to a question worth investigating","image":"/resources/jurassic-rescue/hero-chapter-01.webp"},{"label":"Dinosaurs & adaptation","title":"Meet life built for a different world.","description":"Compare prehistoric animals and plants, connecting teeth, armour, wings and body shapes with how living things fed, moved and survived.","example":"What a dinosaur’s features can tell us","image":"/resources/jurassic-rescue/hero-chapter-03.webp"},{"label":"Earth & deep time","title":"A planet that never stood still.","description":"Put the Triassic, Jurassic and Cretaceous in sequence. Explore changing environments and investigate the evidence behind mass extinction.","example":"Changing habitats, volcanoes and the asteroid impact","image":"/resources/jurassic-rescue/hero-chapter-05.webp"}],"resourceUrl":"/teaching-resources/jurassic-rescue/","teachingPreview":{"label":"FOSSIL ACTIVITY","title":"Think like a palaeontologist","image":"/adventure/jurassic-rescue/worksheet.svg"}}}],"$L14"]}]
