,"logo":"/adventure/ocean-compass/title-logo.png","hero":"/ocean-compass-keyvisual-v2.jpg","heroAlt":"Captain HighTides holding the Ocean Compass beside a sailing ship and tropical sea","heroSeal":["Five oceans.","One big mystery."],"chartCaption":"Follow the clues. Recover the compass.","collectionSubject":"Polar Bear","collectionHeadline":["Collect. Play.","Level up."],"collectionIntroduction":"Find stickers as you explore. Learn the stories behind them, then play minigames and upgrade your collection to complete the game.","accessHeadline":["Ready to come","aboard?"],"theme":{"id":"nautical","accent":"#56e1db","brass":"#e7bb6c","ink":"#052635","heroPosition":"66% 12%","motif":"compass"},"headline":["Ahoy, explorer!","Ready to dive in?"],"introduction":"Join Captain HighTides! Spot ocean wonders, crack the clues and bring his missing compass home.","mission":"A missing compass. Six amazing places. From a museum full of clues to the icy Arctic, there’s something new to discover at every stop!","discoveryCount":35,"collectibleCount":127,"story":{"headline":["The Ocean Compass","has vanished."],"description":"Captain HighTides needs an explorer. Follow his trail across the world’s five oceans, uncover the clues and bring the legendary compass home.","artwork":"/adventure/ocean-compass/ocean-world-manta-v3.png","artworkCaption":"Five oceans. One big mystery.","learningLine":"Discover science, geography and wildlife as you play.","rewardBoxCount":2},"teasers":[{"title":"A mystery to unravel","description":"Follow the clues. Make connections. See where your curiosity takes you.","image":"/resources/ocean-compass/hero-museum.webp","imagePosition":"39% 50%","alt":"A close glimpse of maps and treasures in a nautical museum"},{"title":"A world to explore","description":"Dive beneath the surface of an ocean bursting with life.","image":"/resources/ocean-compass/hero-reef.webp","imagePosition":"63% 50%","alt":"Sunlight falling through a colourful underwater reef"},{"title":"Wonders worth finding","description":"Look a little closer. There’s always more to discover.","image":"/resources/ocean-compass/hero-pacific.webp","imagePosition":"74% 50%","alt":"A small glimpse beneath the water beside a distant island"}],"chapters":[{"id":"nautical-museum","title":"Nautical Museum","setting":"Where the mystery begins","image":"/resources/ocean-compass/hero-museum.webp","description":"A compass has gone missing! Search maps, ships and treasures to find where the adventure begins.","discoveries":["Compass","World map","Diving suit","Sailing ship","Lighthouse"],"learning":["Use maps and compasses to find your way.","Meet ships, lighthouses and diving equipment."]},{"id":"great-barrier-reef","title":"The Great Barrier Reef","setting":"A living world beneath the waves","image":"/resources/ocean-compass/hero-reef.webp","description":"Dive into a colourful underwater world. Can you find a clownfish, a turtle and a giant clam?","discoveries":["Brain coral","Clownfish","Sea turtle","Giant clam"],"learning":["Meet the animals that call the reef home.","Find out why this ocean habitat needs care."]},{"id":"pacific","title":"The Pacific Ocean","setting":"Islands, wildlife & volcanic wonders","image":"/resources/ocean-compass/hero-pacific.webp","description":"Meet dolphins and whales, discover volcanic islands and look out for a curious octopus!","discoveries":["Dolphins","Polynesian statue","Humpback whale","Volcanic rock","Octopus"],"learning":["Discover how volcanoes make islands.","Meet ocean animals and Polynesian discoveries."]},{"id":"arctic","title":"The Arctic Ocean","setting":"Discover life at the frozen frontier","image":"/resources/ocean-compass/hero-arctic.webp","description":"Brrr! Take a peek above and below the ice. A polar bear, a seal and the northern lights are waiting.","discoveries":["Polar bear","Inuit sled","Seal","Iceberg","Aurora"],"learning":["Find out how animals stay warm in the ice.","Discover icebergs and the northern lights."]},{"id":"indian-lagoon","title":"The Indian Lagoon","setting":"Hidden waters & stories of trade","image":"/resources/ocean-compass/hero-indian.webp","description":"Who’s hiding in the lagoon? Look for manta rays, whale sharks and clues from old sailing adventures.","discoveries":["Manta ray","Spices","Anchor","Lobster","Whale shark"],"learning":["Meet the wildlife of warmer ocean waters.","Discover how spices travelled by sea."]},{"id":"atlantic","title":"The Atlantic Ocean","setting":"Into the deep","image":"/resources/ocean-compass/hero-atlantic.webp","description":"Dive down into the deep! Explore the Titanic, meet mysterious creatures and discover an underwater robot.","discoveries":["RMS Titanic","Anglerfish","ROV robot","Giant squid","Jellyfish"],"learning":["See how robots help people explore the deep.","Find out about the Titanic and deep-sea animals."]}],"demo":{"chapter":"The Arctic Ocean","chapterNumber":4,"scene":"/resources/ocean-compass/hero-arctic.webp","sceneAlt":"An Arctic panorama with northern lights, sea ice and a polar bear swimming below the surface","object":"polar bear","hotspot":{"x":68,"y":73},"clue":"Look below the water. Someone is taking an icy swim.","fact":"Polar bears live in the Arctic and are excellent swimmers. Their thick fur and fat layer help them stay warm on sea ice.","question":"What helps polar bears stay warm in the Arctic?","answers":["Thick fur and blubber","Bright white colour","Sharp claws","Long tails"],"correctAnswer":0,"explanation":"Polar bears have thick fur and a layer of fat called blubber that help keep them warm in freezing temperatures.","sticker":"/adventure/ocean-compass/polar-bear-discovery.jpg"},"learningStages":[{"id":"journey","label":"Journey","headline":["One mystery.","Six chapters."],"description":"Follow Captain HighTides across six connected chapters, with new discoveries and challenges at every stop.","image":"/ocean-compass-screens-20261106/journey.jpg","alt":"The actual Ocean Compass game map showing the story, connected chapters and quizzes"},{"id":"explore","label":"Explore","headline":["Look closer.","Discover more."],"description":"Search richly illustrated ocean scenes. Tap discoveries to watch short videos and uncover fascinating facts.","image":"/ocean-compass-screens-20261106/explore.jpg","alt":"The actual Arctic exploration screen, with a swimming polar bear and a rail of discoveries"},{"id":"play","label":"Play","headline":["Put your knowledge","into play."],"description":"Try quizzes and minigames that turn what you’ve learned into something to solve, practise and remember.","image":"/ocean-compass-screens-20261106/activity.jpg","alt":"An actual Arctic spot-the-difference minigame from Ocean Compass"},{"id":"collect","label":"Collect","headline":["Build your own","ocean collection."],"description":"Fill a stickerbook with your discoveries, earn Gold editions through play and unlock Epic artwork with gems.","image":"/ocean-compass-screens-20261106/collection-mixed.jpg","alt":"The actual Arctic stickerbook showing Discovery, Gold and Epic editions together"}],"editions":[{"id":"discovery","label":"Discovery","image":"/adventure/ocean-compass/polar-bear-discovery.jpg","explanation":"Find a discovery, learn its story and earn its sticker."},{"id":"gold","label":"Gold","image":"/adventure/ocean-compass/polar-bear-gold.jpg","explanation":"Beat the sticker’s minigame to earn its Gold edition."},{"id":"epic","label":"Epic","image":"/adventure/ocean-compass/polar-bear-epic.jpg","explanation":"Use your gems to unlock its Epic artwork."}],"learningAreas":[{"image":"/resources/ocean-compass/hero-pacific.webp","label":"Geography","title":"A bigger picture of our planet.","description":"Connect the five oceans with distinctive environments, routes and places. Maps and compass directions give the voyage a real-world frame.","example":"From the museum’s world map to the Arctic Ocean"},{"image":"/resources/ocean-compass/hero-reef.webp","label":"Science & nature","title":"A closer look at how life works.","description":"Investigate marine habitats, animal adaptations and the technology that lets people explore beneath the waves.","example":"Why a polar bear can thrive where we would freeze"},{"image":"/resources/ocean-compass/hero-museum.webp","label":"History & exploration","title":"Stories behind the discoveries.","description":"Meet the objects and ideas that shaped ocean exploration, from sailing ships and diving suits to the Titanic and underwater robots.","example":"Old voyages. New technology. Fresh questions."}],"resourceImage":"/adventure/ocean-compass/teaching-preview.png","resourceUrl":"/teaching-resources/ocean-compass/"}}],"$L14"]}]
