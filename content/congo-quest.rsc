enture/congo-quest/title-logo.webp","hero":"/adventure/congo-quest/hero.jpg","heroAlt":"Lola paddling a canoe through a sunlit Congo rainforest, with an elephant and the Moabi tree in the distance","collectionSubject":"Chameleon","collectionHeadline":["Collect. Play.","Level up."],"collectionIntroduction":"Find stickers as you explore. Learn the stories behind them, then play minigames and upgrade your collection to complete the game.","accessHeadline":["Ready to explore","the rainforest?"],"theme":{"id":"rainforest","accent":"#99e0b4","brass":"#f2d57c","ink":"#082e2c","heroPosition":"64% 25%","heroMobilePosition":"63% top","logoTop":"22%","motif":"leaf","colors":["#147e57","#0d5f4d","#163a44"],"backdrop":"/adventure/congo-quest/planet-backdrop.jpg","pattern":"/adventure/congo-quest/pattern.svg"},"discoveryCount":32,"collectibleCount":127,"story":{"headline":["Follow Lola’s clues.","Find the Moabi Tree."],"description":"Lola’s father left a trail of clues. Follow her into the Congo Basin, meet its extraordinary wildlife and uncover the legend of the Moabi Tree.","artwork":"/adventure/congo-quest/world.png","artworkCaption":"One rainforest. A world of discoveries.","learningLine":"Discover wildlife, habitats and the connections that keep a rainforest alive.","rewardBoxCount":2},"chapters":[{"id":"river","title":"River Life","image":"/resources/congo-quest/hero-river.webp"},{"id":"canopy","title":"Under the Canopy","image":"/resources/congo-quest/hero-canopy.webp"},{"id":"giants","title":"Giants of Africa","image":"/resources/congo-quest/hero-giants.webp"},{"id":"trees","title":"Life in the Trees","image":"/resources/congo-quest/hero-trees.webp"},{"id":"caves","title":"The Hidden Caves","image":"/resources/congo-quest/hero-caves.webp"},{"id":"moabi","title":"The Great Moabi","image":"/resources/congo-quest/hero-moabi.webp"}],"learningStages":[{"id":"journey","label":"Journey","headline":["One living world.","Six connected chapters."],"description":"Follow Lola through six connected chapters, with new habitats to explore, clues to follow and challenges to solve.","image":"/adventure/congo-quest/journey.jpg","alt":"The actual Congo Quest journey map, with story, chapter and quiz nodes"},{"id":"explore","label":"Explore","headline":["Look closer.","The forest is alive."],"description":"Search richly illustrated rainforest scenes. Tap discoveries to watch short videos and learn how animals, plants and people share this remarkable place.","image":"/adventure/congo-quest/explore.jpg","alt":"Actual Congo Quest gameplay exploring the rainforest and its wildlife"},{"id":"play","label":"Play","headline":["Put your knowledge","into play."],"description":"Use what you discover in quizzes, puzzles and minigames. Every challenge gives a new reason to look, think and try again.","image":"/adventure/congo-quest/play.jpg","alt":"A genuine Congo Quest matching activity about fungi and rainforest nutrients"},{"id":"collect","label":"Collect","headline":["Build your own","rainforest collection."],"description":"Find stickers, revisit the facts and play for Gold editions. Use gems to unlock Epic artwork as your rainforest collection grows.","image":"/adventure/congo-quest/collect.jpg","alt":"The actual Congo Quest stickerbook, showing river discoveries and a chapter badge"}],"editions":[{"id":"discovery","label":"Discovery","image":"/adventure/congo-quest/chameleon-discovery.jpg","explanation":"Find a discovery, learn its story and earn its sticker."},{"id":"gold","label":"Gold","image":"/adventure/congo-quest/chameleon-gold.jpg","explanation":"Beat the sticker’s minigame to earn its Gold edition."},{"id":"epic","label":"Epic","image":"/adventure/congo-quest/chameleon-epic.jpg","explanation":"Use your gems to unlock its Epic artwork."}],"learningAreas":[{"label":"Geography & communities","title":"A river that connects a world.","description":"Locate the Congo Basin in Africa and discover how rivers support travel, food and everyday life for the people who live there.","example":"Maps, rainfall and life beside the Congo River","image":"/resources/congo-quest/hero-river.webp"},{"label":"Wildlife & habitats","title":"Every creature has its place.","description":"Compare rainforest animals and explore how their features help them find food, move and stay safe, from the forest floor to the canopy.","example":"Camouflage, climbing and life in different forest layers","image":"/resources/congo-quest/hero-giants.webp"},{"label":"Ecosystems & conservation","title":"See how a forest works.","description":"Discover how fungi return nutrients, animals spread seeds and bees carry pollen. Connect these small actions with the future of the forest.","example":"Living connections, from a seed to a giant tree","image":"/resources/congo-quest/hero-moabi.webp"}],"resourceUrl":"/teaching-resources/congo-quest/","teachingPreview":{"label":"HABITAT ACTIVITY","title":"Layers of the rainforest","image":"/adventure/congo-quest/worksheet.svg"}}}],"$L14"]}]
