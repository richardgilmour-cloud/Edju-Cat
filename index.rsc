13:["$","$L18",null,{"adventures":[{"slug":"world-explorer","title":"World Explorer","description":"Travel across continents, meet new cultures and complete challenges inspired by our world.","subject":"Geography · Cultures","image":"/world-explorer-thumbnail.jpg","heroImage":"/world-explorer-thumbnail.jpg","tone":"world","mission":"Set off across the globe, discover remarkable places and meet the people and cultures that make our world extraordinary.","learning":["Continents, countries and landmarks","People, places and cultures","How geography shapes the way we live"]},{"slug":"ocean-compass","title":"The Ocean Compass","description":"Explore the world’s five oceans with Captain HighTides and recover his mystical compass.","subject":"Oceans · Geography","image":"/ocean-compass-thumbnail.jpg","heroImage":"/ocean-compass-hero.jpg","tone":"ocean","mission":"Join Captain HighTides on a voyage across the five oceans and help recover the pieces of his mysterious lost compass.","learning":["The world’s five oceans","Marine habitats and ocean life","Exploration, observation and discovery"]},{"slug":"jurassic-rescue","title":"Jurassic Rescue","description":"Journey through prehistoric worlds, uncover ancient clues and rescue the missing Dr Everstone.","subject":"Dinosaurs · Science","image":"/jurassic-rescue-thumbnail.png","heroImage":"/jurassic-rescue-hero.jpg","tone":"jurassic","mission":"Travel into a prehistoric world, follow Dr Everstone’s trail and use your growing dinosaur knowledge to bring her home.","learning":["Dinosaurs and prehistoric life","Fossils, habitats and adaptation","Scientific clues and classification"]},{"slug":"galaxy-academy","title":"Galaxy Academy","description":"Train at Galaxy Academy, explore the Solar System and complete missions among the stars.","subject":"Space · Science","image":"/galaxy-academy-thumbnail.jpg","heroImage":"/galaxy-academy.jpg","tone":"galaxy","mission":"Enrol at Galaxy Academy, train as a space explorer and complete missions across our remarkable Solar System.","learning":["The Sun, planets and moons","Our place in the Solar System","Space travel and exploration"]},{"slug":"congo-quest","title":"Congo Quest","description":"Venture into the Congo rainforest, discover its wildlife and help protect its ecosystem.","subject":"Nature · Ecosystems","image":"/congo-quest-thumbnail.jpg","heroImage":"/congo-quest-thumbnail.jpg","tone":"congo","mission":"Journey deep into the Congo rainforest, meet its extraordinary wildlife and take on a mission to protect its ecosystem.","learning":["Rainforest layers and habitats","Wildlife and food chains","Ecosystems and conservation"]},{"slug":"ancient-egypt","title":"Ancient Egypt","description":"Explore ancient Egypt, decipher forgotten clues and uncover the secrets of the pharaohs.","subject":"History · Discovery","image":"/ancient-egypt-thumbnail.jpg","heroImage":"/ancient-egypt.jpg","tone":"egypt","mission":"Step into ancient Egypt, decipher clues and uncover the stories hidden among its temples, tombs and treasures.","learning":["Pharaohs, pyramids and belief","Everyday life in ancient Egypt","Artefacts, symbols and historical evidence"]}]}]
