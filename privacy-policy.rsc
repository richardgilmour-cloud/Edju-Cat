12:["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Provide and manage the website, app, family account, learning content and support."}],["$","td",null,{"children":"Account, child profile, technical, usage and support information."}],["$","td",null,{"children":"Performance of a contract and our legitimate interests in delivering and supporting the service."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Process purchases and maintain transaction records."}],["$","td",null,{"children":"Account, contact and purchase information."}],["$","td",null,{"children":"Performance of a contract and compliance with legal obligations."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Send launch news and other optional marketing."}],["$","td",null,{"children":"Contact information and marketing choices."}],["$","td",null,{"children":"Your consent. You may withdraw it at any time."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Reply to enquiries and explore partnership or investment opportunities."}],["$","td",null,{"children":"Contact, enquiry and support information."}],["$","td",null,{"children":"Our legitimate interests in communicating with people who contact us and developing Edju Cat."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Keep the service safe, prevent fraud or abuse and diagnose faults."}],["$","td",null,{"children":"Technical, usage, account and security information."}],["$","td",null,{"children":"Our legitimate interests in protecting users, our service and our business, and compliance with legal obligations where applicable."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Understand and improve how the service performs."}],["$","td",null,{"children":"Limited technical, usage and diagnostic information."}],["$","td",null,{"children":"Our legitimate interests, where those interests do not override users’ rights. Consent will be requested before any non-essential analytics technology is used."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Display prices in GBP, USD or EUR based on a visitor’s country."}],["$","td",null,{"children":"IP address and country-level location."}],["$","td",null,{"children":"Our legitimate interests in presenting relevant regional pricing. Visitors can override the detected currency at any time."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Establish, exercise or defend legal claims and respond to authorities."}],["$","td",null,{"children":"Relevant records associated with the matter."}],["$","td",null,{"children":"Legal obligation and legitimate interests."}]]}]]}]
13:["$","section",null,{"children":[["$","h2",null,{"children":"Children’s privacy"}],["$","p",null,{"children":"Edju Cat is designed for children aged 6–12 but accounts are managed by a parent or guardian. We aim to collect only the information needed to provide the learning experience, use high-privacy settings by default and avoid advertising based on a child’s behaviour. Where the law requires consent for processing a child’s information, we will obtain it from the child or their parent or guardian as appropriate for their age and country."}],["$","p",null,{"children":"We will provide shorter, age-appropriate explanations inside the app wherever a child needs to understand how their information is being used. Parents and guardians may contact us to access, correct or delete information associated with their child’s profile."}]]}]
14:["$","section",null,{"children":[["$","h2",null,{"children":"Who we share information with"}],["$","p",null,{"children":"We share information only where necessary with service providers acting for us, including website and app hosting, country-level currency detection, security, email delivery, customer support, payment processing and app-store providers. Current website services include MailerLite for the launch list, Google reCAPTCHA for form security and FormSubmit for partnership enquiries. Purchases may be processed by Stripe when commerce is enabled."}],["$","p",null,{"children":"We may also disclose information to professional advisers, regulators, law-enforcement bodies or another organisation involved in a genuine business sale or restructuring, where permitted by law. We do not sell personal information."}]]}]
15:["$","section",null,{"children":[["$","h2",null,{"children":"International transfers"}],["$","p",null,{"children":"Some service providers may process information outside the United Kingdom or European Economic Area. Where required, we use an applicable adequacy decision or approved contractual safeguards, such as the UK International Data Transfer Agreement or Addendum and the European Commission’s Standard Contractual Clauses. You may contact us for more information about the safeguards relevant to your information."}]]}]
16:["$","section",null,{"children":[["$","h2",null,{"children":"How long we keep information"}],["$","ul",null,{"className":"policy-list","children":[["$","li",null,{"children":"Launch-list information is kept until you unsubscribe or withdraw consent. We may retain a minimal suppression record so we respect that choice."}],["$","li",null,{"children":"General enquiries are normally kept for up to 24 months after the last meaningful contact."}],["$","li",null,{"children":"Account and learning-progress information is kept while the account is active and is deleted or anonymised after closure, normally within 90 days, unless it must be retained for legal or security reasons."}],["$","li",null,{"children":"Purchase and tax records may be kept for up to six years where required for accounting, tax or legal purposes."}],["$","li",null,{"children":"Security and diagnostic records are generally kept for no longer than 12 months unless an incident requires a longer investigation."}]]}],["$","p",null,{"children":"We may keep anonymised information that can no longer identify an individual."}]]}]
17:["$","section",null,{"children":[["$","h2",null,{"children":"Your rights"}],["$","p",null,{"children":"Depending on the circumstances, you may have the right to access your information, correct inaccurate information, ask us to erase or restrict its use, receive a portable copy, and object to processing based on legitimate interests or to direct marketing."}],["$","p",null,{"className":"policy-right-callout","children":[["$","strong",null,{"children":"You have an absolute right to object to direct marketing at any time."}]," You can unsubscribe using the link in any marketing email or contact us at ",["$","a",null,{"href":"mailto:hello@edjucat.com","children":"hello@edjucat.com"}],"."]}],["$","p",null,{"children":"Where we rely on consent, you may withdraw it at any time. Withdrawal does not affect processing that was lawful before consent was withdrawn. We may need to verify your identity or confirm that you are authorised to act for a child before completing a request."}]]}]
18:["$","section",null,{"children":[["$","h2",null,{"children":"Automated decisions"}],["$","p",null,{"children":"We do not currently use personal information to make solely automated decisions that produce legal or similarly significant effects. Learning progression and recommendations may respond automatically to activity within the app, but they are used to support the experience rather than make consequential decisions about a child."}]]}]
19:["$","section",null,{"children":[["$","h2",null,{"children":"Security"}],["$","p",null,{"children":"We use proportionate organisational and technical measures designed to protect personal information against loss, misuse, unauthorised access, alteration and disclosure. No online service can guarantee absolute security."}]]}]
1a:["$","section",null,{"children":[["$","h2",null,{"children":"Cookies and similar technology"}],["$","p",null,{"children":["Our use of cookies and browser storage is explained in our ",["$","a",null,{"href":"/cookie-policy","children":"Cookie Policy"}],"."]}]]}]
1b:["$","section",null,{"children":[["$","h2",null,{"children":"Complaints"}],["$","p",null,{"children":["Please contact us first so we can try to resolve your concern. You also have the right to complain to the UK Information Commissioner’s Office through ",["$","a",null,{"href":"https://ico.org.uk/make-a-complaint/","target":"_blank","rel":"noreferrer","children":"ico.org.uk"}],". If EU GDPR applies, you may complain to the data-protection authority in the EU or EEA country where you live, work or believe an infringement occurred."]}]]}]
1c:["$","section",null,{"children":[["$","h2",null,{"children":"Changes to this policy"}],["$","p",null,{"children":"We will review this policy as Edju Cat develops and update the date above when it changes. We will give appropriate notice before using personal information for a materially different purpose."}]]}]
1d:["$","section",null,{"children":[["$","h2",null,{"children":"Contact"}],["$","p",null,{"children":["For questions or requests concerning personal information, email ",["$","a",null,{"href":"mailto:hello@edjucat.com","children":"hello@edjucat.com"}],"."]}]]}]
