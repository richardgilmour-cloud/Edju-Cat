1:["$","main",null,{"className":"policy-page","children":[["$","a",null,{"className":"policy-back","href":"/","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," Back to Edju Cat"]}],["$","article",null,{"className":"policy-card","children":[["$","img",null,{"className":"policy-logo","src":"/edju-cat-logo.svg","alt":"Edju Cat"}],["$","span",null,{"className":"policy-kicker","children":"Your information"}],["$","h1",null,{"children":"Privacy policy"}],["$","p",null,{"className":"policy-updated","children":"Last updated 1 September 2026"}],["$","section",null,{"children":[["$","h2",null,{"children":"Who we are"}],["$","p",null,{"children":["EDJU CAT LTD is the controller responsible for the personal information described in this policy. We are a private limited company registered in Scotland under company number SC900521. Our registered office is Alloa Business Centre, The Whins, Alloa, Scotland, FK10 3SA. In this policy, “Edju Cat”, “we”, “us” and “our” refer to EDJU CAT LTD and the Edju Cat website, app and related services. You can contact us at ",["$","a",null,{"href":"mailto:hello@edjucat.com","children":"hello@edjucat.com"}],"."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"What this policy covers"}],["$","p",null,{"children":"This policy explains how we collect and use personal information when you visit our website, join our launch list, contact us, purchase or use Edju Cat content, or manage a family account. It applies under the UK GDPR, the Data Protection Act 2018 and, where applicable, the EU GDPR."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Information we collect"}],["$","ul",null,{"className":"policy-list","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Contact information:"}]," a parent, guardian, educator, investor or partner’s name, email address and messages sent to us."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Marketing choices:"}]," whether you have asked to receive Edju Cat news and when you gave or withdrew that choice."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Account information:"}]," a parent or guardian’s account details and family settings when accounts become available."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Child profile information:"}]," limited information needed to provide the learning experience, such as a nickname or display name, age range, selected content, progress, achievements and rewards."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Purchase information:"}]," products purchased, transaction references and payment status. Payment-card details are processed by the payment provider and are not stored by Edju Cat."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Technical and usage information:"}]," IP address, device and browser type, security events, pages or content used, app performance and diagnostic information."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Approximate location:"}]," country-level location derived from an IP address so we can display prices in an appropriate currency. We do not use this feature for precise location tracking."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Support information:"}]," information you provide when reporting a problem, requesting help or exercising a privacy right."]}]]}],["$","p",null,{"children":"We ask parents and guardians not to send us unnecessary personal information about a child through our public contact forms."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"How and why we use information"}],["$","div",null,{"className":"policy-table-wrap","children":["$","table",null,{"className":"policy-table","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Purpose"}],"$L10","$L11"]}]}],"$L12"]}]}]]}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]]}]
10:["$","th",null,{"children":"Information used"}]
